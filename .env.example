PORT=3000
REDIS_URL=redis://127.0.0.1:6379      # Upstash/hosted: rediss://default:<password>@<host>:6379
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=1h
RATE_LIMIT_FAIL_OPEN=true              # false = return 503 if Redis is down
BREAKER_FAILURES=5                     # consecutive 5xx/errors before the circuit opens
BREAKER_OPEN_MS=10000                  # cool-down before a probe request is allowed
PROXY_TIMEOUT_MS=10000
# Override upstream targets from config/routes.json:
# UPSTREAM_USERS=https://my-users-service.onrender.com
# UPSTREAM_ORDERS=https://my-orders-service.onrender.com
